// Cloudflare Worker: SEOS -> Groq relay. See README.md.
// No secrets here: RELAY_TOKEN and AI_GATEWAY_TOKEN are Worker secrets.
{
  "name": "seos-groq-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Served only at https://seos-groq-relay.<account-subdomain>.workers.dev.
  "workers_dev": true,
  "preview_urls": false,
  // The binding resolves the fixed Groq provider URL through AI Gateway. This avoids
  // direct Worker-to-provider egress while retaining the caller's Groq credential.
  "ai": { "binding": "AI" },
  // No Workers Logs / invocation logs: requests carry a provider key and prompts.
  "observability": { "enabled": false },
  "logpush": false
}
