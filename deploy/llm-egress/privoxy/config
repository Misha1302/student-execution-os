confdir /etc/privoxy
logdir /tmp

listen-address 0.0.0.0:8118
toggle 1
enable-remote-toggle 0
enable-remote-http-toggle 0
enable-edit-actions 0
accept-intercepted-requests 0
socket-timeout 60
forwarded-connect-retries 1

# SOCKS5t resolves provider hostnames through Tor, avoiding local DNS resolution
# for requests that the application deliberately sends to this proxy.
forward-socks5t / tor:9050 .
