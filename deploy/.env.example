# Public DNS name pointing at this host; Caddy obtains the TLS certificate automatically.
SEOS_DOMAIN=plan.example.com
# The deployment process sets this to the exact tested Git commit.
SEOS_REVISION=unknown
# open | closed — whether new users may register.
SEOS_REGISTRATION=open
# Extra browser origins allowed to call the API (comma separated). The Android app's
# origins (https://localhost, http://localhost) are always allowed.
SEOS_CORS_ORIGINS=
# Secrets are files, not variables (see deploy/README.md "Secrets"):
#   deploy/secrets/worker/fcm-service-account.json  FCM push (reminder worker only)
#   deploy/secrets/api/credential.key               encrypts each user's own AI key
#   deploy/secrets/academic/academic-feed.key        encrypts private calendar URLs
# Compact FCM JSON may instead come from a secret store through this variable:
SEOS_FCM_SERVICE_ACCOUNT_JSON=
# For ~/seos-staging/<release-sha>/deploy/docker-compose.yml use the persistent
# sibling directory ~/seos-staging/shared/secrets/api.
SEOS_API_SECRETS_DIR=./secrets/api
SEOS_ACADEMIC_SECRETS_DIR=./secrets/academic
# STARTER is opt-in. Platform credentials never grant access while this is off.
SEOS_STARTER_LLM_ENABLED=0
SEOS_PLATFORM_LLM_PROVIDER=
SEOS_PLATFORM_LLM_MODEL=
SEOS_PLATFORM_LLM_BASE_URL=
# Comma-separated, primary then standby. Files take precedence over the legacy value.
SEOS_PLATFORM_LLM_API_KEY_FILES=
# Backward-compatible single credential; prefer *_FILES in production.
SEOS_PLATFORM_LLM_API_KEY=
SEOS_STARTER_LLM_PERIOD_SECONDS=2592000
SEOS_STARTER_LLM_ACCOUNT_REQUEST_LIMIT=100
SEOS_STARTER_LLM_ACCOUNT_TOKEN_LIMIT=100000
SEOS_STARTER_LLM_GLOBAL_REQUEST_LIMIT=10000
SEOS_STARTER_LLM_GLOBAL_TOKEN_LIMIT=10000000
SEOS_STARTER_LLM_MAX_OUTPUT_TOKENS=1200
SEOS_STARTER_LLM_TOKEN_RESERVATION_OVERHEAD=256

# Optional: only LLM calls to the exact comma-separated hosts below use this
# operator-controlled HTTP(S) egress proxy. This is useful when a provider accepts
# a key from your laptop/VPN but rejects the VPS network or region.
# Prefer a file if the proxy URL contains credentials; deploy/secrets/api is already
# mounted at /run/secrets/seos in the API container.
SEOS_LLM_EGRESS_PROXY=
SEOS_LLM_EGRESS_PROXY_FILE=
SEOS_LLM_EGRESS_PROXY_HOSTS=
# Example:
# SEOS_LLM_EGRESS_PROXY_FILE=/run/secrets/seos/llm-egress-proxy.url
# SEOS_LLM_EGRESS_PROXY_HOSTS=api.groq.com
#
# The optional deploy/docker-compose.tor.yml overlay sets the proxy URL itself and
# defaults the exact-host allowlist to api.groq.com. Administrators normally only
# override SEOS_LLM_EGRESS_PROXY_HOSTS when enabling that overlay.
#
# Alternative to a proxy: the operator's Cloudflare Worker relay
# (deploy/cloudflare-groq-relay). It terminates TLS, so it can technically see the
# provider key and prompts it forwards (it does not log or store them); a CONNECT
# proxy/Tor cannot. It serves only the exact hosts listed below. Configure either the
# proxy or the relay for a host, never both. The token is file-only.
SEOS_LLM_EGRESS_RELAY_URL=
SEOS_LLM_EGRESS_RELAY_TOKEN_FILE=
SEOS_LLM_EGRESS_RELAY_HOSTS=
# Example:
# SEOS_LLM_EGRESS_RELAY_URL=https://seos-groq-relay.misha13022008.workers.dev
# SEOS_LLM_EGRESS_RELAY_TOKEN_FILE=/run/secrets/seos/llm-egress-relay.token
# SEOS_LLM_EGRESS_RELAY_HOSTS=api.groq.com
