# Public DNS name pointing at this host; Caddy obtains the TLS certificate automatically.
SEOS_DOMAIN=plan.example.com
# open | closed — whether new users may register.
SEOS_REGISTRATION=open
# Extra browser origins allowed to call the API (comma separated). The Android app's
# origins (https://localhost, http://localhost) are always allowed.
SEOS_CORS_ORIGINS=
# Optional production integrations. If absent, diagnostics report UNCONFIGURED.
# FCM credentials belong in the deployment secret store, never in the repository.
SEOS_FCM_ENDPOINT=
SEOS_FCM_BEARER_TOKEN=
